# Frontend API location; the Vite development proxy uses /api by default.
VITE_API_BASE_URL=/api

# Public OIDC client settings. Set these to match the trusted identity provider
# and the backend OIDC_ISSUER / OIDC_AUDIENCE configuration.
VITE_OIDC_AUTHORITY=https://identity.example.com/
VITE_OIDC_CLIENT_ID=manufacturing-knowledge-assistant-frontend
VITE_OIDC_AUDIENCE=manufacturing-knowledge-assistant
VITE_OIDC_SCOPE=openid profile email
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
