# Application Configuration
APP_NAME="Revision-Aware Multimodal Manufacturing AI Assistant"
ENVIRONMENT="development"
DEBUG=true
DEMO_MODE=true
PORT=8000
HOST="0.0.0.0"

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database
DATABASE_URL="sqlite:///./data/mfg_assistant.db"

# Storage
UPLOAD_DIR="./data/uploads"
IMAGE_DIR="./data/extracted_images"
SYNTHETIC_CORPUS_DIR="./data/synthetic_corpus"

# Retrieval Settings
DEFAULT_RETRIEVAL_MODE="hybrid"
TOP_K_RETRIEVAL=5
BM25_K1=1.5
BM25_B=0.75
RRF_K=60
EMBEDDING_PROVIDER="fallback" # "fallback" (deterministic n-gram TF-IDF vectorizer) or "sentence-transformers"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# LLM Provider Configuration
LLM_PROVIDER="deterministic_demo" # "deterministic_demo", "openai", "custom_endpoint"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# OIDC authentication (required for protected write actions)
# Leave unset for read-only demo use; protected actions fail closed until configured.
OIDC_ISSUER=""
OIDC_AUDIENCE=""
OIDC_JWKS_URL=""
OIDC_ROLES_CLAIM="roles"

# Safety & Governance
STRICT_REVISION_FILTER=true
ALLOW_SUPERSEDED_FALLBACK=false
HIGH_RISK_MANDATORY_REVIEW=true
MAX_FILE_SIZE_MB=25
